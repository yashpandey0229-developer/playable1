    "test": "tsx --test tests/**/*.test.ts",
    "package": "npm run build && node scripts/package-zip.mjs"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
