{
  "name": "bottle-blast",
  "version": "1.0.0",
  "private": true,
  "description": "Bottle Blast - Nostalgic Arcade Bottle Shooting Game for YouTube Playables",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
